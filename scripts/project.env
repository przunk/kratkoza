# shellcheck shell=bash
#
# Everything the scripts need to know about Kratkoza, and the only file in scripts/ that should
# differ from the workshop template (/mnt/workspace/.tooling/templates/android). Sourced by
# use-tooling.sh and check-store-metadata.sh; never executed.

APP_NAME="Kratkoza"            # in messages and in the release tag's message
APP_SLUG="kratkoza"            # file prefix in dist/, and the namespace for logs and temp files
APP_MODULE="app"               # the Gradle application module
KEY_ALIAS="kratkoza-upload"    # the alias build-bundle.sh offers; Enter accepts it
KEYSTORE_DEFAULT="/mnt/d/Projects/google-play-upload.jks"   # the path build-bundle.sh offers
STORE_LOCALES="en-US pl-PL"    # store/listing/<locale>; the first one's notes go into the tag message
PLAY_TRACK="Closed testing"    # where release.sh's last lines tell you to upload

# No native code.
NDK_VERSION=""
CMAKE_VERSION=""

# Kratkoza builds inside the checkout (app/build), unlike the template's default of a build root
# off the mount: its settings.gradle.kts never moved the build directory, and the in-tree build has
# worked here since the first commit. Kept as it is so that adopting the scripts changes no Gradle
# file and therefore nothing about the app that gets built.
MODULE_BUILD_DIR_RELATIVE="$APP_MODULE/build"

# Optional hooks (see the template's README): require_sources, extra_checks, release_prepare.
# Kratkoza needs none of them.
