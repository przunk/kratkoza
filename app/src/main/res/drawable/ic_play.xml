<?xml version="1.0" encoding="utf-8"?>
<!--
    A play triangle — resume the game in progress.

    Drawn here rather than taken from a Material icon package: material-icons-core is not on the
    compile classpath, and material-icons-extended is a large dependency for a handful of glyphs
    (technical_requirements.md section 9). One 24dp grid and one visual weight across the set.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8,5.5L19,12L8,18.5Z" />
</vector>
